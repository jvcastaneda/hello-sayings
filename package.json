  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "prom-client": "^15.1.3"
  }
}
